# Copy this file to .env and fill in your values
PORT=5000
NODE_ENV=development

# MongoDB connection string (local or MongoDB Atlas)
MONGO_URI=mongodb://127.0.0.1:27017/hospital_beds

# Long random string. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string

# The user who registers with this email automatically becomes admin
ADMIN_EMAIL=anasgada512@gmail.com

# Only needed if the frontend is hosted on a different domain. Comma separated.
CLIENT_URL=http://localhost:5173

# Set to false to stop auto-seeding sample departments, beds, doctors and patients on first start
SEED_ON_START=true
